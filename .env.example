# Copy to .env.local and fill in. Never commit the real .env.

# --- Auth -----------------------------------------------------------------
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# Public origin of the app. Used to build password-reset and verification
# links, so it must be your real deployed URL, not localhost.
BETTER_AUTH_URL=http://localhost:3000

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Databases ------------------------------------------------------------
# better-auth (users, sessions, accounts)
AUTH_DATABASE_URL=
# App data (organizations, projects, activity)
PROJECT_DATABASE_URL=

# --- Transactional email --------------------------------------------------
RESEND_API_KEY=

# REQUIRED for email verification. Must be a sender on a domain you have
# verified in Resend. Resend's onboarding@resend.dev test address only delivers
# to your own inbox, so it is not usable here.
#
# While this is unset, email verification is NOT enforced: anyone can register
# an account using someone else's address, and if that address is later added
# to an organization the registrant receives that access. A warning is logged
# on startup while this is missing. See lib/email.ts.
EMAIL_FROM=
