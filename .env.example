# Copy to .env.local and fill in. Never commit the real .env.

# --- Auth -----------------------------------------------------------------
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# Public origin of the app. Used to build password-reset and verification
# links, so it must be your real deployed URL, not localhost.
BETTER_AUTH_URL=http://localhost:3000

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- GitHub App ------------------------------------------------------------
# A GitHub App is a SEPARATE identity from the OAuth app above. The CLIENT_ID /
# CLIENT_SECRET pair is only for "Sign in with GitHub"; nothing here uses them.
# Create the App at https://github.com/settings/apps. The repository screen can
# register/update the App-level webhook URL and secret below; event subscriptions
# and repository permissions are checked there but must be selected in GitHub.
#
# While these are unset the repository connect flow is unavailable: the install
# endpoint reports the App as unconfigured. See lib/github.ts.
GITHUB_APP_ID=
# The App's slug, used to build the install redirect.
GITHUB_APP_SLUG=
# The App's private key (`.pem`). In a .env file store it on one line with
# literal \n sequences; the value is converted back to real newlines on use.
GITHUB_APP_PRIVATE_KEY=
# Public HTTPS callback URL of the web app's GitHub receiver.
GITHUB_WEBHOOK_URL=https://your-domain.example/api/ingest/github
# Required by the webhook receiver; an empty value fails closed.
GITHUB_WEBHOOK_SECRET=

# --- Databases ------------------------------------------------------------
# better-auth (users, sessions, accounts)
AUTH_DATABASE_URL=
# App data (organizations, projects, activity)
PROJECT_DATABASE_URL=

# --- Transactional email --------------------------------------------------
# REQUIRED for email verification. Use the hostname and port supplied by your
# SMTP provider. Port 465 enables implicit TLS by default; ports 587/2525 use
# STARTTLS when the server advertises it. Set SMTP_SECURE=true only when your
# provider requires implicit TLS on another port.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Optional for an unauthenticated local relay. If either value is set, both are
# required before email verification is enabled.
SMTP_USER=
SMTP_PASSWORD=

# May be an address or a display-name form such as
# "CodePulse <no-reply@example.com>". Ensure the relay permits this sender.
#
# REQUIRED for email verification.
#
# While this or the SMTP connection settings are unset, email verification is
# NOT enforced: anyone can register
# an account using someone else's address, and if that address is later added
# to an organization the registrant receives that access. A warning is logged
# on startup while this is missing. See lib/email.ts.
EMAIL_FROM=

# --- API service (apps/api) ------------------------------------------------
# Port for the Express receiver. The web app proxies /api/ingest/* here.
API_PORT=4000
# Where the web app sends the proxied ingest requests. Usually the same as
# API_PORT; set this if the API runs elsewhere (e.g. a container hostname).
API_INTERNAL_URL=http://localhost:4000
# Shared random secret used only for authenticated web-to-API queue commands.
API_INTERNAL_SECRET=
# Comma-separated browser origins allowed to call the API directly. Leave EMPTY
# in production: the browser should only ever talk to the web origin, which
# keeps the session cookie SameSite=Lax and needs no CORS. For local dev, set
# this to http://localhost:3000 if you call the API directly from the browser.
API_ALLOWED_ORIGINS=
# Jobs in flight per worker instance.
WORKER_CONCURRENCY=5
# Repository backfills make several paginated GitHub API requests per job.
WORKER_SYNC_CONCURRENCY=2
# Discover newly attached repositories and stale repositories this often.
WORKER_SYNC_DISCOVERY_MS=300000
# Reconcile completely synced repositories daily.
REPOSITORY_SYNC_INTERVAL_MS=86400000

# --- Redis (BullMQ) ---------------------------------------------------------
# REQUIRED by the API service and the worker. Without it the receiver accepts
# and records a delivery, then fails to enqueue, and GitHub retries. Start a
# local one with `pnpm infra:up`.
REDIS_URL=redis://localhost:6379
